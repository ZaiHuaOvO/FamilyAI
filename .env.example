# 复制为 .env 后填写真实值；.env 不得提交到 Git
APP_HOST=127.0.0.1
APP_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3.5:4b
API_ACCESS_TOKEN=请替换为真正的随机长密钥
REQUEST_TIMEOUT_SECONDS=180
MAX_MESSAGE_CHARS=6000
MAX_CONCURRENT_REQUESTS=2
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=12000
REQUEST_LOG_SIZE=200
EMBEDDING_MODEL=qwen3-embedding:0.6b
KB_DB_PATH=data/knowledge.db
KB_TOP_K=4
KB_MAX_CONTEXT_CHARS=6000
KB_CHUNK_CHARS=500
KB_CHUNK_OVERLAP=80
MEMORY_DB_PATH=data/memory.db
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.3
MEMORY_MAX_CONTEXT_CHARS=2000
MEMORY_MAX_CHARS=500
AUTO_MEMORY_ENABLED=true
AUTO_MEMORY_MIN_CHARS=4
AUTO_MEMORY_MAX_ITEMS=3
TASKS_DB_PATH=data/tasks.db
# 可选天气：填写经纬度后启用；例如北京 39.9 / 116.4
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION_NAME=
WEATHER_TIMEOUT_SECONDS=10
